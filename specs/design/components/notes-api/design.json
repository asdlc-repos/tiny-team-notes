{
  "name": "notes-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "notes-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5"
  ],
  "description": "Single service that owns the notes: lists every note newest first and posts a new note for the signed-in team member, enforcing the 1 to 280 character plain-text limit. It offers no edit or delete, sends no notifications and holds no attachments. It is separate from the web app because the browser app and the data have different lifecycles; the board's data is reached only through it.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Sign-in identity provider whose tokens the gateway checks before calls reach this service.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "tiny-team-notes-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "notes-db",
      "description": "Stores the notes.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "tiny-team-notes-notes-db",
        "envBindings": {
          "dbname": "NOTES_DB_DBNAME",
          "host": "NOTES_DB_HOST",
          "password": "NOTES_DB_PASSWORD",
          "port": "NOTES_DB_PORT",
          "user": "NOTES_DB_USER"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
