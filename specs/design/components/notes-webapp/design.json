{
  "name": "notes-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "notes-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5"
  ],
  "description": "Single-page board where a signed-in team member writes a note of up to 280 characters and reads all notes, newest first, with author and time. Holds no data of its own and does not edit, delete, notify or attach.",
  "dependencies": [
    {
      "kind": "component",
      "name": "notes-api",
      "description": "Lists notes and posts a new note.",
      "wiring": {
        "endpoint": {
          "component": "tiny-team-notes-notes-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "NOTES_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Signs team members in through single sign-on.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "tiny-team-notes-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
